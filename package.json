{
  "name": "nanning-city-atlas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "npm run dev",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/test-*.mjs",
    "test:data": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "preview": "node scripts/preview.mjs",
    "data:fetch": "python3 scripts/fetch_geodata.py",
    "terrain:resample": "python3 scripts/resample_terrain.py",
    "data:prepare": "python3 scripts/prepare_geodata.py",
    "models:build": "blender --background --python-exit-code 1 --python blender/build_city.py && python3 scripts/pack_city.py && npm run models:scope",
    "models:scope": "python3 scripts/prepare_urban_core_boundary.py && python3 scripts/scope_city.py --publish",
    "test:data:baseline": "python3 scripts/run_baseline_tests.py"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "type": "module",
  "description": "An interactive Nanning geographic atlas built with Three.js and Blender"
}
